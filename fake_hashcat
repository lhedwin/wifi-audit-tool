#!/usr/bin/env python3
import sys, time, json
args = sys.argv[1:]
if '-I' in args:
    # Simula `hashcat -I` sin dispositivos
    print('', end='')
    sys.exit(0)
# Simula ejecución con --status-json y emite líneas JSON periódicas
end = 100_000_000
cur = 0
steps = 50
step = max(1, end // steps)
rates = [50000, 200000, 500000, 1200000, 2500000]
while cur <= end:
    percent = cur / end if end else 0
    rate = rates[min(len(rates)-1, cur // max(1, end // len(rates)))]
    data = {
        "progress": {"cur": cur, "end": end, "percent": percent},
        "speed": {"0": {"rate": rate}},
        "estimated_stop": time.time() + max(1, (end-cur)//max(1, rate)),
        "status": 0
    }
    print(json.dumps(data))
    # Imprimir ocasionalmente una linea no-JSON similar a hashcat
    if (cur // step) % 5 == 0:
        print("Session Name: fake-session")
    sys.stdout.flush()
    time.sleep(0.1)
    cur += step
sys.exit(0)
